# Copie para .env e preencha UMA das chaves para ativar o modo generativo.
# Sem nenhuma chave o agente roda em modo determinístico, com respostas
# montadas por template a partir dos mesmos fatos calculados.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# Força um provedor específico: auto | openai | gemini | deterministico
# BUSSOLA_LLM_PROVIDER=auto

# BUSSOLA_TEMPERATURE=0.2
# BUSSOLA_MAX_TOKENS=700
# BUSSOLA_LLM_TIMEOUT=30
